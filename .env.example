DATABASE_URL="postgresql://leadtrack:leadtrack@localhost:5432/leadtrack?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Meta (Facebook) Lead Ads integration
META_APP_ID="replace-with-your-meta-app-id"
META_APP_SECRET="replace-with-your-meta-app-secret"
META_WEBHOOK_VERIFY_TOKEN="replace-with-a-verify-token-you-choose"
META_SYSTEM_USER_TOKEN="replace-with-your-meta-system-user-access-token"

# 32-byte (64 hex char) key used to encrypt client Meta AND Google Ads tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_TOKEN_ENCRYPTION_KEY="replace-with-a-generated-64-char-hex-key"

# Shared secret required as "Authorization: Bearer <value>" to call /api/cron/reconcile-meta-leads
CRON_SECRET="replace-with-a-long-random-string"

# Google Ads integration
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
GOOGLE_ADS_DEVELOPER_TOKEN="replace-with-your-google-ads-developer-token"

# Stripe billing
STRIPE_SECRET_KEY="sk_test_replace-me"
STRIPE_WEBHOOK_SECRET="whsec_replace-me"
STRIPE_PRICE_ID_STARTER="price_replace-me-starter"
STRIPE_PRICE_ID_GROWTH="price_replace-me-growth"
STRIPE_PRICE_ID_SCALE="price_replace-me-scale"

# Production bootstrap admin — used only by `npm run seed:production`
# (prisma/seed-production.ts). Not the dev dummy-data seed.
SEED_ADMIN_EMAIL="replace-with-your-real-admin-email"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# Only used by docker-compose.yml's postgres service / DATABASE_URL construction
POSTGRES_USER="leadtrack"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="leadtrack"
