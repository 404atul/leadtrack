generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  agency_admin
  client_user
}

enum Platform {
  meta
  google
}

enum LeadStatus {
  New
  Contacted
  Qualified
  Follow_up
  Disqualified
  Converted
  Lost
}

enum LeadQuality {
  Hot
  Warm
  Cold
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users   User[]
  clients Client[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  clientId     String?
  client       Client?  @relation("ClientUsers", fields: [clientId], references: [id])
  createdAt    DateTime @default(now())

  createdClients Client[]      @relation("ClientCreatedBy")
  assignedLeads  Lead[]        @relation("LeadAssignedTo")
  activityLogs   ActivityLog[]

  @@index([agencyId])
}

model Client {
  id                  String    @id @default(cuid())
  agencyId            String
  agency              Agency    @relation(fields: [agencyId], references: [id])
  name                String
  industry            String?
  metaBusinessId      String?
  metaPageId          String?
  metaPageName        String?
  metaUserAccessToken String?
  metaTokenExpiresAt  DateTime?
  metaAdAccountId     String?
  metaAdAccountName   String?
  metaConnectedAt     DateTime?
  googleRefreshToken  String?
  googleCustomerId    String?
  googleCustomerName  String?
  googleWebhookToken  String?   @unique
  googleConnectedAt   DateTime?
  createdAt           DateTime  @default(now())
  createdBy           String
  creator             User      @relation("ClientCreatedBy", fields: [createdBy], references: [id])

  users User[] @relation("ClientUsers")
  leads Lead[]
  metaConnectionAttempts   MetaConnectionAttempt[]
  googleConnectionAttempts GoogleConnectionAttempt[]

  @@index([agencyId])
}

model MetaConnectionAttempt {
  id                      String   @id @default(cuid())
  clientId                String
  client                  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  encryptedLongLivedToken String
  tokenExpiresAt          DateTime
  pagesJson               Json
  adAccountsJson          Json
  createdAt               DateTime @default(now())

  @@index([clientId])
}

model GoogleConnectionAttempt {
  id                     String   @id @default(cuid())
  clientId               String
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  encryptedRefreshToken  String
  customersJson          Json
  createdAt              DateTime @default(now())

  @@index([clientId])
}

model Lead {
  id           String       @id @default(cuid())
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  platform     Platform
  campaignName String
  adSetName    String
  adName       String
  name         String
  phone        String
  email        String?
  formData     Json?
  leadgenId    String?      @unique
  googleLeadId String?      @unique
  rawPayload   Json?
  status       LeadStatus   @default(New)
  quality      LeadQuality?
  assignedTo   String?
  assignee     User?        @relation("LeadAssignedTo", fields: [assignedTo], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  activityLogs ActivityLog[]

  @@index([clientId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  createdAt DateTime @default(now())

  @@index([leadId])
}
